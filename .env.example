# Copia questo file in .env e modifica i valori prima del deploy

# Chiave segreta Flask (usata per sessioni e CSRF)
SECRET_KEY=cambia-questa-chiave-flask-in-produzione

# -----------------------------------------------------------------------
# Multi-tenant: Master DB (registro tenant + master admin)
# -----------------------------------------------------------------------

# Percorso del file master.db cifrato con SQLCipher
MASTER_DB_PATH=master.db

# Chiave di cifratura AES-256 del master database
# IMPORTANTE: se perdi questa chiave, perdi l'accesso al registro tenant
MASTER_DB_KEY=cambia-questa-chiave-master-in-produzione

# -----------------------------------------------------------------------
# Multi-tenant: Tenant DB (un file per organizzazione)
# -----------------------------------------------------------------------

# Directory contenente i file .db dei tenant
TENANT_DB_DIR=tenants/

# Directory contenente i file .db dei template
TEMPLATE_DB_DIR=templates/

# File JSON con le chiavi di cifratura per ogni tenant
# IMPORTANTE: non committare questo file! Contiene le chiavi AES-256
TENANT_KEYS_PATH=tenant_keys.json

# -----------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------

# Chiave segreta per la firma dei token JWT
JWT_SECRET_KEY=cambia-questa-chiave-jwt-in-produzione

# Durata token JWT in secondi (default: 3600 = 1 ora)
JWT_ACCESS_TOKEN_EXPIRES=3600

# -----------------------------------------------------------------------
# Regole di business
# -----------------------------------------------------------------------

# Numero massimo di step nella history per calendario
MAX_HISTORY_STEPS=500

# Ore lavorative giornaliere di default (formato decimale: 6.5 = 6h30m)
ORE_GIORNALIERE_DEFAULT=6.5

# Modalita' debug Flask (impostare a 0 in produzione)
FLASK_DEBUG=0
